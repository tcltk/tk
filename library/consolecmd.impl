# FILE: console.tcl
#
#       Provides a console window.
#
# Last modified on: $Date: 2005-10-15 06:00:15 $
# Last modified by: $Author: jcw $
#
# This file is evaluated to provide a console window interface to the
# root Tcl interpreter of an OOMMF application.  It calls on a script
# included with the Tk script library to do most of the work, making use
# of Tk interface details which are only semi-public.  For this reason,
# there is some risk that future versions of Tk will no longer support
# this script.  That is why this script has been isolated in a file of
# its own.
 
########################################################################
# If the Tcl command 'console' is already in the interpreter, our work
# is done.
########################################################################
if {[llength [info commands console]]} {
    # console is already a native command on this platform (Windows/Mac) -
    # do nothing and leave it alone.
    return
}
 
########################################################################
# Check Tcl/Tk support
########################################################################
package require Tcl 8.6-
package require Tk 8.6-

set _ [file join $tk_library console.tcl]
if {![file readable $_]} {
    return -code error "File not readable: $_"
}

########################################################################
# Provide the support which the Tk library script console.tcl assumes
########################################################################
# ConsoleSetup and ConsoleSetupFinish (defined further below) together
# do all of the following at most once, the first time any console
# subcommand is actually invoked (see the "console" proc below) - not
# unconditionally at file-load/source time. This keeps the file itself
# inert when merely sourced or scanned (e.g. by auto_mkindex), the same
# property Schelte's tip-561-autoload branch has by a similar design.
proc ConsoleSetup {} {
    if {[info exists ::tk::console::interp] \
            && [interp exists $::tk::console::interp]} {
        # Already set up - nothing to do.
        return
    }

# 1. Create an interpreter for the console window widget and load Tk
# Ensure the ::tk::console namespace exists before setting a variable
# inside it - a bare "set" on a fully-qualified name requires every
# namespace in the path to already exist (unlike proc/namespace eval,
# it doesn't auto-create parent namespaces).
namespace eval ::tk::console {}

set ::tk::console::interp [interp create]
$::tk::console::interp eval [list set tk_library $::tk_library]
$::tk::console::interp alias exit exit
load "" Tk $::tk::console::interp

# Withdraw immediately, before anything else runs. Tk's initial map of a
# new toplevel is a deferred idle-time task, not immediate - withdrawing
# later (e.g. after sourcing console.tcl) can race against that pending
# task and fail to prevent the window flashing visible. Withdrawing here,
# before any event-loop activity has a chance to process that task, is
# the reliable way to keep it hidden until "console show" is called.
$::tk::console::interp eval {wm withdraw .}

    ConsoleSetupFinish
}

# 2. A command 'console' in the application interpreter
proc console {{sub ""} args} {
    if {$sub ni {hide show title eval}} {
        error "bad option \"$sub\": should be hide, show, title, or eval"
    }
    ConsoleSetup
    upvar #0 ::tk::console::interp consoleInterp
    switch -exact -- $sub {
        title {
            if {[llength $args] > 1} {
                error "wrong # args: should be \"console title ?title?\""
            } elseif {[llength $args]} {
                $consoleInterp eval wm title . [list [lindex $args 0]]
            } else {
                return [$consoleInterp eval wm title .]
            }
        }
        hide {
            $consoleInterp eval wm withdraw .
            # Pop transforms when hiding
            if {$::tkConsoleOut::pushed} {
                catch {chan pop stdout}
                catch {chan pop stderr}
                catch {fconfigure stdout -encoding utf-8}
                catch {fconfigure stderr -encoding utf-8}
                set ::tkConsoleOut::pushed 0
            }
            return "" ;# avoid output of 0
        }
        show {
            $consoleInterp eval wm deiconify .
            # Only push transforms if not already active - chan push
            # always succeeds even if already pushed, so pushing again
            # here would stack a second transform layer, and a single
            # chan pop on close would then leave one layer behind,
            # silently redirecting output into the now-hidden console.
            if {!$::tkConsoleOut::pushed} {
                chan push stdout {::tkConsoleOut stdout}
                chan push stderr {::tkConsoleOut stderr}
                set ::tkConsoleOut::pushed 1
            }
            return ""
        }
        eval {
            if {[llength $args] != 1} {
                error "wrong # args: should be \"console eval script\""
            }
            $consoleInterp eval [lindex $args 0]
        }
    }
}
# 3. Alias a command 'consoleinterp' in the console window interpreter
#       to cause evaluation of the command 'consoleinterp' in the
#       application interpreter.
;proc consoleinterp {sub cmd} {
    switch -exact -- $sub {
        eval {
            uplevel #0 $cmd
        }
        record {
            history add $cmd
            catch {uplevel #0 $cmd} retval
            return $retval
        }
        default {
            error "bad option \"$sub\": should be eval or record"
        }
    }
}

namespace eval tkConsoleOut {
        variable consoleInterp {}
        variable pushed 0
        proc initialize {what x mode}    {
            fconfigure $what -buffering none
            return {initialize finalize write flush}
        }
        proc finalize {what x}  { }
        proc write {what x data}  { 
            variable consoleInterp
            set consoleInterp $::tk::console::interp
            # Check if interpreter still exists
            if {[interp exists $consoleInterp]} {
                # Get the channel's actual encoding instead of hardcoding UTF-8
                set enc [fconfigure $what -encoding]
                if {$enc ne "binary"} {
                    set data [encoding convertfrom $enc $data]
                }
                set data [string map {\r ""} $data]
                $consoleInterp eval [list ::tk::ConsoleOutput $what $data]
            } else {
                # Interpreter gone - pass data through to terminal
                return -code error "console closed"
            }
            return ""
        }
    proc flush {what x}              { }
    namespace export {[a-z]*}
    namespace ensemble create -parameters what
}

# Restore normal output if console widget goes away...
proc Oc_RestorePuts {slave} {
    # Pop the transforms to restore normal output
    catch {chan pop stdout}
    catch {chan pop stderr}
    set ::tkConsoleOut::pushed 0

    # Notify user
    puts stderr "\n=== Console closed: output restored to terminal ==="
    flush stderr
}

# ConsoleSetupFinish - called once from ConsoleSetup above, once the
# interp/Tk-load part is done. Split out so "console" (which needs
# ConsoleSetup already defined) could stay near its original position -
# Tcl only cares about call order between procs, not definition order,
# so ConsoleSetup can call this even though it's defined later in the
# file.
proc ConsoleSetupFinish {} {
$::tk::console::interp alias consoleinterp consoleinterp

# 4. Bind the <Destroy> event of the application interpreter's main
#    window to kill the console (via ::tk::ConsoleExit)
bind . <Destroy> [list +if {[string match . %W]} [list catch \
        [list $::tk::console::interp eval ::tk::ConsoleExit]]]

# 5. Redirect stdout/stderr messages to the console using TIP#230 channel
#    transforms.
# (tkConsoleOut namespace/procs are defined once, unconditionally, below -
#  see note after this proc. Only the interp/binding setup needs to be
#  deferred; defining procs has no side effects worth guarding.)

# Transforms are pushed lazily on first "console show" (see the console
# proc above) rather than unconditionally here, so that loading the
# module has no visible side effects until explicitly requested.

# 6. No matter what Tk_Main says, insist that this is an interactive  shell
set ::tcl_interactive 1

########################################################################
# Evaluate the Tk library script console.tcl in the console interpreter
########################################################################
$::tk::console::interp eval source [list [file join $::tk_library console.tcl]]
$::tk::console::interp alias Oc_RestorePuts Oc_RestorePuts $::tk::console::interp
$::tk::console::interp eval {
    # Use WM_DELETE_WINDOW protocol to catch console close before destruction
    wm protocol . WM_DELETE_WINDOW {
        Oc_RestorePuts
        wm withdraw .
    }
}

# Start hidden regardless of console.tcl's own tcl_interactive check -
# nothing should be visible or redirected until "console show" is
# explicitly called.
$::tk::console::interp eval {wm withdraw .}

# addition by Schelte Bron ([sbron]):
# Allow functional pasting with the middle mouse button
catch {
    # on particularly old Tk versions, virtual events might not be present?
    # FIXME: this should be guarded with an appropriate version test
    $::tk::console::interp eval {
        bind Console <<PasteSelection>> {
            if {$tk_strictMotif || ![info exists tk::Priv(mouseMoved)] \
            || !$tk::Priv(mouseMoved)} {
                catch {
                    set clip [::tk::GetSelection %W PRIMARY]
                    set list [split $clip \n\r]
                    tk::ConsoleInsert %W [lindex $list 0]
                    foreach x [lrange $list 1 end] {
                        %W mark set insert {end - 1c}
                        tk::ConsoleInsert %W "\n"
                        tk::ConsoleInvoke
                        tk::ConsoleInsert %W $x
                    }
                }
            }
        }
    }
}
$::tk::console::interp eval {
    bind Console <Control-equal> {event generate .console <Control-plus>}
    bind Console <Control-KP_Add> {event generate .console <Control-plus>}
    bind Console <Control-KP_Subtract> {event generate .console <Control-minus>}
}

# ::tk::console::interp is intentionally left set here - unlike the old
# baked-in version, this console proc does a live lookup on every call,
# so it needs this variable to still exist for the lifetime of the
# application, not just during initial setup. It's namespaced under
# ::tk::console:: rather than left as a bare global, since it now has to
# persist for the whole program instead of being unset right after setup.

# Set the initial title directly (not via the public "console" command,
# to avoid re-entering ConsoleSetup while it's still running).
$::tk::console::interp eval [list wm title . "[wm title .] Console"]
}

