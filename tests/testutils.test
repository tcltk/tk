# NOTE
#
# All tests in this test file have been constrained with test constraint "testutils".
# This constraint isn't set anywhere, and therefore false by default. Therefore,
# the tests in this file are skipped in a regular invocation of the Tk test suite.
# In order to run these test, you need to use the tcltest option
# "-constraints testutils" in the invocation, possibly combined with the option
# "-file testutils.test" to exclude other test files, or with
# "-limitconstraints true" to exclude other tests.

#
# TESTFILE INITIALIZATION
#

package require tcltest 2.2; # needed in mode -singleproc 0

# Load the main script main.tcl, which takes care of:
# - setup for the application and the root window
# - importing commands from the tcltest namespace
# - loading of the testutils mechanism along with its utility procs
# - loading of Tk specific test constraints (additionally to constraints
#   provided by the package tcltest)
source [file join [tcltest::configure -testdir] main.tcl]

# Ensure a pristine initial window state
resetWindows

assert {"testutils" in [info procs testutils]}

#
# LOCAL UTILITY PROCS
#

proc deleteTimerEvents {} {
    foreach id [after info] {
	after cancel $id
	puts "Warning: left-over timer event $id was cancelled"
    }
}

set timingDebug 1
tcltest::configure -iterations 5

#
# TESTS
#

#
# Testutils domain "generic"
#

test evalOnWindowEvent-1.0 {timeout} -setup {
    deleteTimerEvents
    proc myBgerrorCmd {args} {
	set ::x "timeout"
	puts -nonewline [lindex $args 0]
    }
    set savBgerrorCmd [interp bgerror {}]
    interp bgerror {} myBgerrorCmd
    set x "init"
} -body {
    evalOnWindowEvent . <<EvalOnEvent>> {set x "triggered"} 10
    vwait x
    list $x [bind . <<EvalOnEvent>>] [after info]
} -cleanup {
    interp bgerror {} $savBgerrorCmd
    rename myBgerrorCmd {}
    unset -nocomplain savBgerrorCmd x
} -result "timeout {} {}" -output "evalOnWindowEvent onevent#* timed out" -match glob

test evalOnWindowEvent-1.1 {custom timeout handler} -setup {
    deleteTimerEvents
    proc evalOnWindowEventTimeout {ID} {
	set ::x "timeout"
	puts -nonewline "custom time out for $ID"
    }
    set x "init"
} -body {
    evalOnWindowEvent . <<EvalOnEvent>> {set x "triggered"} 10
    vwait x
    list $x [bind . <<EvalOnEvent>>] [after info]
} -cleanup {
    rename evalOnWindowEventTimeout {}
    unset -nocomplain x
} -result "timeout {} {}" -output "custom time out for onevent#*" -match glob

test evalOnWindowEvent-2.1 {script evaluation skipped for child of intended toplevel} -setup {
    deleteTimerEvents
    pack [frame .f]; # Apparently the frame needs to be mapped once to receive
    update;	     # the window event generated in the test's body. After the
		     # first mapping, one may "pack forget .f", but we don't
		     # really care about that.
    proc evalOnWindowEventTimeout {ID} {
	set ::x "timeout"
	puts -nonewline "custom time out for $ID"
    }
} -body {
    set x "init"
    after 10 {event generate .f <<EvalOnEvent>>}
    evalOnWindowEvent . <<EvalOnEvent>> {set x "triggered"} 100
    vwait x
    list $x [bind . <<EvalOnEvent>>] [after info]
} -cleanup {
    rename evalOnWindowEventTimeout {}
    destroy .f
    unset -nocomplain x
} -result "timeout {} {}" -output "custom time out for onevent#*" -match glob

test evalOnWindowEvent-2.2 {script evaluation triggered for intended toplevel} -setup {
    deleteTimerEvents
} -body {
    set x "init"
    after 10 {event generate . <<EvalOnEvent>>}
    evalOnWindowEvent . <<EvalOnEvent>> {set x "triggered"}
    vwait x
    list $x [bind . <<EvalOnEvent>>] [after info]
} -cleanup {
    unset -nocomplain x
} -result "triggered {} {}"

test evalOnWindowEvent-2.3 {cancel} -setup {
    deleteTimerEvents
} -body {
    set x "init"
    set y "init"
    after 50 {
	event generate . <<EvalOnEvent>>
	set y "done"
    }
    set ID [evalOnWindowEvent . <<EvalOnEvent>> {set x "triggered"} 100]
    after 10 [list evalOnWindowEvent cancel $ID]
    vwait y; # allow cancel operation and event generation to happen in the meantime
    list $x [bind . <<EvalOnEvent>>] [after info]
} -cleanup {
    unset -nocomplain ID x y
} -result "init {} {}" -output ""

#
# NOTES regarding testing of evalWhen
#
# * proc evalWhen is intended for conditions that are more involved than the
#   value of a single variable. Specifically, conditions related to a window's
#   state are intended. This ought be considered for the test cases that exercise
#   success. For other test cases, targetting the value of a single variable is
#   entirely OK.
#
# * evalWhen uses iterations where the waiting duration increases by powers
#   of 2. For this reason the condition passed to evalWhen is evaluated
#   after durations of (2^i-1) ms, i.e.: 1, 3, 7, 15, 31, 63, 127 ms .... etc.
#   Tests scheduling timer events need to take these step sizes into account.
#
test evalWhen-1.0 {default timeout} -setup {
    deleteTimerEvents
    proc myBgerrorCmd {args} {
	set ::z 1
	puts -nonewline [lindex $args 0]
    }
    set savBgerrorCmd [interp bgerror {}]
    interp bgerror {} myBgerrorCmd
} -body {
    set x 0
    set y 0
    evalWhen {$x == 11} {set y 22} 10
    vwait z
    list $x $y [after info]
} -cleanup {
    interp bgerror {} $savBgerrorCmd
    rename myBgerrorCmd {}
    unset -nocomplain x y z savBgerrorCmd
} -result "0 0 {}" -output "evalWhen when#* timed out" -match glob

test evalWhen-1.1 {custom timeout handler} -setup {
    deleteTimerEvents
    proc evalWhenTimeout {ID} {
	puts -nonewline "custom time out for $ID"
	set ::z 1
    }
} -body {
    set x 0
    set y 0
    set z 0
    evalWhen {$x == 11} {set y 22} 10
    vwait z
    list $y [after info]
} -cleanup {
    rename evalWhenTimeout {}
    unset -nocomplain x y z
} -result "0 {}" -output "custom time out for when#*" -match glob

test evalWhen-2.1 {script evaluated after condition was reached while waiting} -setup {
    deleteTimerEvents
    wm deiconify .
} -body {
    set x 0
    frame .f
    if {$timingDebug} {
	testutils import timing
	dt.reset
    }
    after 20 {pack .f}
    evalWhen {[winfo ismapped .f]} {
	set x 22
    }
    vwait x
    if {$timingDebug} {
	#
	# On a system that allows the current test process ample time, the expected
	# duration for the condition to be evaluated as true is: 31 ms (== 2^5 - 1)
	#
	puts "duration = [dt.get] (31 expected)"
	testutils forget timing
    }
    list $x [after info]
} -cleanup {
    destroy .f
    unset -nocomplain x
} -result "22 {}"

test evalWhen-2.2 {cancel} -setup {
    deleteTimerEvents
} -body {
    set x 0
    set y 0
    set z 0
    after 50 {
	set x 11
	set z 1
    }
    set evalWhenID [evalWhen {$x == 11} {set y 22}]; # would become true after 64 ms
    after 10 [list evalWhen cancel $evalWhenID]
    vwait z; # allow cancel operation and timer event on x to happen in the meantime
    list $x $y [after info]
} -cleanup {
    unset -nocomplain x y z evalWhenID
} -result "11 0 {}"

test resetWindows-4b705991cf {Reset of root window geometry is effective. Bug #4b705991cf} -constraints testutils -setup {
    unset -nocomplain result
    # Beware that some windowing systems / window managers impose a minimum
    # width or height on toplevels. The following windowing systems/window managers
    # have been investigated for imposing such a minimum size:
    # x11: no wm (i.e. the bare display server), e16, Fluxbox, Fvwm, Icewm,
    #      KDE/Plasma, Metacity, Openbox, TWM, WindowMaker, Xvwm
    # win32 and macOS/aqua. Those exhibiting such a minimum size are:
    #
    # ws-wm		width	height
    # ----------------------------------
    # win32		116	1
    # x11-KDE/Plasma	8	33
    # x11-WindowMaker	5	5
    # ----------------------------------
    #
    # Therefore, don't use a width less than 116, or a height less than 33 for
    # this test.
    #
} -body {
    . configure -width 151 -height 94
    wm geometry . +123+123
    resetWindows
    lappend result [wm geometry .]
    pack [frame .f -width 137 -height 109 -bg blue]
    update
    lappend result [winfo width .] [winfo height .]
} -cleanup {
    unset -nocomplain result
    destroy .f
    resetWindows
} -result {200x200+100+100 137 109}

#
# testutils command section 1: invalid invocations
#
test testutils-1.1 {invalid subcommand} -constraints testutils -body {
    testutils foo
} -result {invalid subCmd "foo". Usage: testutils export|import|forget ?domain domain ...?} -returnCodes error

test testutils-1.2 {invalid #args for subCmd export} -constraints testutils -body {
    testutils export foo
} -result {invalid #args. Usage: testutils export} -returnCodes error

test testutils-1.3 {invalid #args for subCmd import} -constraints testutils -body {
    testutils import
} -result {invalid #args. Usage: testutils import|forget domain ?domain ...?} -returnCodes error

test testutils-1.4 {invalid #args for subCmd forget} -constraints testutils -body {
    testutils forget
} -result {invalid #args. Usage: testutils import|forget domain ?domain ...?} -returnCodes error

test testutils-1.5 {invalid domain for subCmd import} -constraints testutils -body {
    testutils import foo
} -result {testutils domain "foo" doesn't exist} -returnCodes error

test testutils-1.6 {invalid domain for subCmd forget} -constraints testutils -body {
    testutils forget foo
} -result {testutils domain "foo" doesn't exist} -returnCodes error

#
# COMMON TEST SETUP
#

# Create a domain namespace for testing export, import, forget
assert {"::tk::test::foo" ni [namespace children ::tk::test]}
assert {"::tk::test::zez" ni [namespace children ::tk::test]}
catch {rename init {}}
catch {rename kuk {}}
unset -nocomplain bar pip
namespace eval ::tk::test::foo {
    proc init {} {
	variable bar 123
	variable pip
    }
    proc kuk {} {}
    testutils export
}
set initVars [info vars]; lappend initVars initVars

#
# testutils command section 2: Domain failures for forget and import
#
test testutils-2.1 {forget not-imported domain} -constraints testutils -body {
    testutils forget foo
} -result {testutils domain "foo" was not imported} -returnCodes error

test testutils-2.2 {duplicate import} -constraints testutils -body {
    testutils import foo
    testutils import foo
} -result "" -returnCodes ok -cleanup {
    testutils forget foo
}

#
# testutils command section 3. Import procs
#
test testutils-3.1 {utility proc is imported and init proc is not} -constraints testutils -body {
    testutils import foo
    expr {([info procs kuk] eq "kuk") && ([info procs init] eq "")}
} -result 1 -cleanup {
    testutils forget foo
}

test testutils-3.2 {forget removes utility proc} -constraints testutils -body {
    testutils import foo
    testutils forget foo
    info procs kuk
} -result {}

test testutils-3.3 {import fails: proc already exists} -constraints testutils -setup {
    namespace eval ::zez {
	proc kuk {} {}
    }
} -body {
    namespace eval ::zez {
	testutils import foo
    }
} -result "import from testutils domain \"foo\" failed: can't import command \"kuk\": already exists" -returnCodes error -cleanup {
    namespace delete ::zez
}

#
# testutils command section 4. Import variables
#
test testutils-4.1 {associated variables are imported} -constraints testutils -body {
    testutils import foo
    set varNames [info vars]
    foreach name $initVars {
	set varNames [lremove $varNames [lsearch $varNames $name]]
    }
    list [lsort $varNames] [info exists bar] [info exists pip] $bar
} -result [list {bar pip} 1 0 123] -cleanup {
    unset -nocomplain name varNames
    testutils forget foo
}

test testutils-4.2 {
    Repeated initialization keeps imported variable non-existent if it was
    defined without a value, even if a test file inadvertently assigns it
    a value in the meantime.
} -constraints testutils -body {
    catch {
	testutils import foo
    }
    testutils forget foo
    set pip 11111
    testutils import foo
    info exists pip
} -result 0 -cleanup {
    testutils forget foo
}

test testutils-4.3 {import fails: variable already exists} -constraints testutils -setup {
    #
    # We need a pristine new namespace in which the variable bar was never imported
    # and hence no upvar link for it exists.
    #
    namespace eval ::zez {
	set bar 11
    }
} -body {
    namespace eval ::zez {
	testutils import foo
    }
} -result "import from testutils domain \"foo\" failed: variable \"bar\" already exists" -returnCodes error -cleanup {
    namespace delete ::zez
}

test testutils-4.4 {repeated creation/deletion of requesting namespace doesn't fool testutils} -constraints testutils -body {
    namespace eval ::zez {
	testutils import foo
	testutils forget foo
    }
    namespace delete ::zez
    namespace eval ::zez {
	set pip 22
	testutils import foo
	list [info exists bar] [info exists pip] $bar
    }
} -result {1 0 123} -cleanup {
    namespace delete ::zez
}

test waitForWindowEvent-1.0 {timeout} -body {
    waitForWindowEvent . <<WaitForEvent>> 10
} -result "wait for <<WaitForEvent>> event on . timed out (> 10 ms)" -returnCodes error

test waitForWindowEvent-1.1 {don't stop waiting if event received by child of intended toplevel} -setup {
    pack [frame .f]; # Apparently the frame needs to be mapped once to receive
    update;	     # the window event generated in the test's body. You may
		     # "pack forget .f" after the first mapping, but we don't
		     # care about that.
} -body {
    #
    # Note: we generate the event for ".f", and wait for it to be received by "."
    # While "." is included in the binding tags for ".f", waitForWindowEvent
    # should not be led astray by that.
    #
    after 50 {event generate .f <<WaitForEvent>>}
    waitForWindowEvent . <<WaitForEvent>> 100
} -cleanup {
    destroy .f
} -result "wait for <<WaitForEvent>> event on . timed out (> 100 ms)" -returnCodes error

test waitForWindowEvent-1.2 {stop waiting if event received by intended toplevel} -setup {
    if {$timingDebug} {
	testutils import timing
	dt.reset
    }
} -body {
    after 50 {event generate . <<WaitForEvent>>}
    waitForWindowEvent . <<WaitForEvent>> 100
} -cleanup {
    if {$timingDebug} {
	#
	# On a system that allows the current test process ample time, the expected
	# duration for the condition to be evaluated as true is 50 ms.
	#
	puts "duration = [dt.get] (50 expected)"
	testutils forget timing
    }
} -result {}

#
# NOTES regarding testing of waitUntil
#
# * proc waitUntil is intended for conditions that are more involved than the
#   value of a single variable. Specifically, conditions related to a window's
#   state are intended. This ought be considered for the test cases that exercise
#   success. For other test cases, targetting the value of a single variable is
#   entirely OK.
#
# * waitUntil uses iterations where the waiting duration increases by powers
#   of 2. For this reason the condition passed to waitUntil is evaluated
#   after durations of (2^i-1) ms, i.e.: 1, 3, 7, 15, 31, 63, 127 ms .... etc.
#   Tests scheduling timer events need to take these step sizes into account.
#
test waitUntil-1.1 {invalid timeout value} -body {
    waitUntil {whatever} bogus
} -result {invalid timeout value "bogus"} -returnCodes error

test waitUntil-2.1 {timeout default value} -body {
    set x 0
    set afterID [after 150 {set x 1}]; # expected time out after 127 ms
    waitUntil {$x == 1}
} -cleanup {
    after cancel $afterID
    unset afterID x
} -result {wait for condition "$x == 1" timed out (> 100 ms)} -returnCodes error

test waitUntil-2.2 {custom timeout argument} -body {
    set result [list]
    set x 0
    set afterID [after 50 {set x 1}]
    lappend result [catch {waitUntil {$x == 1} 19} errMsg]; # expected time out after 31 ms
    lappend result $errMsg
    lappend result [expr {[after info] eq $afterID}]
    lappend result $x
} -cleanup {
    after cancel $afterID
    unset -nocomplain afterID errMsg result x
} -result {1 {wait for condition "$x == 1" timed out (> 19 ms)} 1 0}

test waitUntil-3.0 {condition true before invocation, complain} -body {
    set x 1
    waitUntil {$x == 1}
} -cleanup {
    unset x
} -result {condition "$x == 1" was true already before the proc's invocation} \
-returnCodes error

test waitUntil-3.1 {condition reached while waiting} -body {
    if {$timingDebug} {
	testutils import timing
	dt.reset
    }
    after 20 {toplevel .t}
    waitUntil {[winfo exists .t] && [winfo ismapped .t]}
    if {$timingDebug} {
	#
	# On a system that allows the current test process ample time, the expected
	# duration for the condition to be evaluated as true is: 31 ms (== 2^5 - 1)
	#
	puts "duration = [dt.get] (31 expected)"
	testutils forget timing
    }
} -cleanup {
    unset -nocomplain duration
    destroy .t
} -result {}

test waitUntil-4.1 {invalid condition syntax} -body {
    waitUntil {bogusCondition} 10
} -result {*invalid*expression*"bogusCondition"*} -returnCodes error -match glob

test waitUntil-4.2 {evaluation of condition results in error} -body {
    waitUntil {$_nonExistentVariable} 10
} -result {can't read "_nonExistentVariable": no such variable} -returnCodes error -match glob

test waitUntil-4.3.1 {reentrancy, two simultaneous waiting procs -> condition true before on #2} -body {
    set x 0
    after 10 {set x 1}
    waitUntil {[waitUntil {$x == 1}] eq ""}
} -cleanup {
    unset -nocomplain x
} -result {condition "[waitUntil {$x == 1}] eq """ was true already before the proc's invocation} -returnCodes error

test waitUntil-4.3.2 {reentrancy, two simultaneous waitings -> timeout on #1} -body {
    set x 0
    waitUntil {[waitUntil {$x == 1} 10] eq ""} 20
} -cleanup {
    unset -nocomplain x
} -result {wait for condition "$x == 1" timed out (> 10 ms)} -returnCodes error

test waitUntil-4.3.3 {reentrancy, two simultaneous waitings, blocking order xy} -body {
    set x 0
    set y 0
    set result [list ]
    after 50 {set x 1; set y 1}; # detect condition true at 64 ms (is first after 32)
    after idle {
	waitUntil {($y == 1) && ([lappend result y:$x$y] ne "dummy")}
    }
    waitUntil {($x == 1) && ([lappend result x:$x$y] ne "dummy")}
    set result
} -cleanup {
    unset -nocomplain x y result
} -result {y:11 x:11}

test waitUntil-4.3.4 {reentrancy, three simultaneous waitings, blocking order xyz} -body {
    set x 0
    set y 0
    set z 0
    set result [list ]
    after 10 {set x 1}
    after 20 {set y 1}
    after 50 {set z 1}; # detect condition true at 64 ms (is first after 32)
			# x and y conditions are evaluated to true immediately
			# after z-condition is evaluated to true
    after idle {
	after idle {
	    waitUntil {($z == 1) && ([lappend result z:$x$y$z] ne "dummy")}
	}
	waitUntil {($y == 1) && ([lappend result y:$x$y$z] ne "dummy")}
    }
    waitUntil {($x == 1) && ([lappend result x:$x$y$z] ne "dummy")}
    set result
} -cleanup {
    unset -nocomplain x y z result
} -result {z:111 y:111 x:111}

test waitUntil-4.3.5 {reentrancy, three simultaneous waitings, blocking order xyz} -body {
    set x 0
    set y 0
    set z 0
    set result [list ]
    after 10 {set z 1}; # detect condition true at 16 ms (first after 8)
    after 25 {set y 1}; # detect condition true at 32 ms (first after 16)
    after 50 {set x 1}; # detect condition true after 64 ms (first after 32)
    after idle {
	after idle {
	    waitUntil {($z == 1) && ([lappend result z:$x$y$z] ne "dummy")}
	}
	waitUntil {($y == 1) && ([lappend result y:$x$y$z] ne "dummy")}
    }
    waitUntil {($x == 1) && ([lappend result x:$x$y$z] ne "dummy")}
    set result
} -cleanup {
    unset -nocomplain x y z result
} -result {z:001 y:011 x:111}

#
# COMMON TEST SETUP
#
# Domain event
#
testutils import event

test mwe-1.0 {initial state is off} -body {
    mwe state
} -result "off"

test mwe-1.1 {mwe on/state} -setup {
    mwe off
} -body {
    mwe on
    mwe on
    mwe state
} -cleanup {
    mwe off
} -result "on"

test mwe-1.2 {mwe off/state} -setup {
    mwe off
} -body {
    mwe on
    mwe off
    mwe state
} -result "off"

test mwe-2.1 {configure, without args return current settings regardless state} -body {
    mwe off
    set result [expr {[mwe configure] eq "-events {<Destroy> <Configure> <Unmap> <Map> <Visibility>  <Expose> <Leave> <Enter> <FocusOut> <FocusIn>} -logvar {}"}]
    mwe on
    lappend result [expr {[mwe configure] eq "-events {<Destroy> <Configure> <Unmap> <Map> <Visibility>  <Expose> <Leave> <Enter> <FocusOut> <FocusIn>} -logvar {}"}]
} -cleanup {
    unset -nocomplain result
    mwe off
} -result {1 1}

test mwe-2.2 {configure, raise error upon mwe reconfigure when on} -setup {
    mwe on
} -body {
    mwe configure {}
} -cleanup {
    mwe off
} -result "mwe must be switched off before configuring" -returnCodes error

test mwe-2.3 {configure, restore defaults} -setup {
    mwe off
    unset -nocomplain result
} -body {
    mwe configure -events dummy1 -logvar dummy2
    set result [expr {[mwe configure] eq "-events dummy1 -logvar dummy2"}]
    mwe configure {}
    lappend result [expr {[mwe configure] eq "-events {<Destroy> <Configure> <Unmap> <Map> <Visibility>  <Expose> <Leave> <Enter> <FocusOut> <FocusIn>} -logvar {}"}]
} -cleanup {
    mwe off
    unset -nocomplain result
} -result {1 1}

test mwe-3.1 {log monitoring result in log variable} -setup {
    mwe off
} -body {
    toplevel .tmp
    mwe on -logvar mweLog
    event generate .tmp <Configure>
    update
    set mweLog
} -cleanup {
    mwe off
    destroy .tmp
} -result {*.tmp|<Configure>|*} -match glob

test mwe-3.2 {log monitoring result to stdout using "mwe pause"} -setup {
    mwe off
} -body {
    toplevel .tmp
    tkwait visibility .tmp
    update
    after idle {event generate .tmp <Configure>}
    mwe pause 10
    mwe state
} -cleanup {
    destroy .tmp
} -result "off" -output {MWE_ON\s+.*\|\.tmp\|<Configure>\|.*\s+MWE_OFF} -match regexp

#
# COMMON TEST CLEANUP
#
testutils forget event

#
# Testutils domain "pointer"
#

#
# COMMON TEST SETUP
#
testutils import pointer

test waitForPointerWin-1.0 {timeout} -setup {
    wm deiconify .
    wm geometry . 200x200+100+100
    update
    event generate . <Motion> -warp 1 -x -50 -y 100
    update
    assert {[getPointerWin] eq ""}
} -body {
    after 10 {event generate . <Motion> -warp 1 -x 100 -y 100}
    waitForPointerWin . 1
} -result {waiting for window "." to become the pointer window timed out (> 1 ms)} -returnCodes error

test waitForPointerWin-1.1 {condition reached} -setup {
    wm deiconify .
    wm geometry . 200x200+100+100
    update
    event generate . <Motion> -warp 1 -x -50 -y 100
    update
    assert {[getPointerWin] eq ""}
} -body {
    after 10 {event generate . <Motion> -warp 1 -x 100 -y 100}
    waitForPointerWin .
} -result {} -returnCodes ok

#
# COMMON TEST CLEANUP
#
testutils forget pointer

#
# Testutils domain "timing"
#

#
# COMMON TEST SETUP
#
testutils import timing

test dt-1.1 {Exercise a timing run, default granularity (milliseconds)} -constraints testutils -setup {
} -body {
    dt.reset
    expr {[dt.get] <= 1}
} -result 1

test dt-1.2 {Exercise granularity microseconds} -constraints testutils -body {
    dt.reset microseconds
    expr {[dt.get] <= 1000}
} -result 1

test dt-1.3 {Exercise granularity seconds} -constraints testutils -body {
    dt.reset seconds
    dt.get
} -result 0

test dt-1.4 {Invalid value for granularity} -constraints testutils -body {
    dt.reset bogus
} -returnCodes error -result {invalid parameter "bogus", expected "microseconds", "milliseconds" or "seconds"}

test progress-1.1 {Exercise a timing run for a loop, granularity microseconds} -constraints testutils -body {
    progress.init microseconds
    while {[incr i] < 10} {
	progress.update
    }
    progress.end
} -errorOutput "......... * microseconds\n" -match glob -cleanup {
    unset i
}

#
# COMMON TEST CLEANUP
#
testutils forget timing

#
# TESTFILE CLEANUP
#

namespace delete ::tk::test::foo
unset -nocomplain bar initVars pip timingDebug
cleanupTests

# EOF
