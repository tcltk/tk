# This file is a Tcl script to test that unsafe child interpreters can load Tk.
#
# Copyright © 1994 The Regents of the University of California.
# Copyright © 1998-2000 Scriptics Corporation.
# All rights reserved.

#
# TESTFILE INITIALIZATION
#

package require tcltest 2.2; # needed in mode -singleproc 0

# Load the main script main.tcl, which takes care of:
# - setup for the application and the root window
# - importing commands from the tcltest namespace
# - loading of the testutils mechanism along with its utility procs
# - loading of Tk specific test constraints (additionally to constraints
#   provided by the package tcltest)
source [file join [tcltest::configure -testdir] main.tcl]

# Ensure a pristine initial window state
resetWindows

#
# TESTS
#

# The constraint "useInstalledWish"
#
# Currently, tests run with "make test" use a binary tktest(.exe) that
# uses the library/ from the Tk source rather than the lib/tk9.1/ or
# //zipfs:/ that belong to a Tk installation.  However, the purpose of
# this test is to ensure that pkgIndex.tcl is in the correct location
# and has the correct contents. For this, tktest(.exe) with the source
# library/ is unsuitable, and the test is valid only if it is run from
# the installed wish((s).exe), e.g.
#
# path1/to/wish  path2/to/tests/all.tcl  -verbose bps \
#         -file interpTk.test  -constraints useInstalledWish

test interpTk-1.1 {load tk in child interpreter} -constraints {useInstalledWish} -setup {
    interp create foo
} -body {
    foo eval package require tk
} -cleanup {
    interp delete foo
} -result 9.1b1

#
# TESTFILE CLEANUP
#

cleanupTests
