# icu.test -- direct tests for the ::tk:: break commands.
#
# These test the PUBLIC contract, which the widget-level tests in
# textGrapheme.test cannot: the index argument and the result are
# Tcl CHAR indices, not byte offsets. The byte-vs-char bug (returning
# 4 for ::tk::startOfCluster "\U0001F600x" 1 instead of 1) passes
# every ASCII test and every widget test, and fails only here.

package require tcltest 2.2
source [file join [tcltest::configure -testdir] main.tcl]

# --- clusters: char indices, not bytes ---
test icu-1.1 {startOfCluster: combining sequence, char index} -body {
    ::tk::startOfCluster "e\u0301x" 1
} -result 0
test icu-1.2 {endOfCluster: combining sequence} -body {
    ::tk::endOfCluster "e\u0301x" 0
} -result 2
test icu-1.3 {startOfCluster: astral char is ONE char index} -body {
    ::tk::startOfCluster "\U0001F600x" 1
} -result 1
test icu-1.4 {endOfCluster: astral char} -body {
    ::tk::endOfCluster "\U0001F600x" 0
} -result 1
test icu-1.5 {startOfCluster: index past end clamps} -body {
    ::tk::startOfCluster "ab" end
} -result 1
test icu-1.6 {startOfCluster: NUL is a real char} -body {
    ::tk::startOfCluster "a\0b" 2
} -result 2
test icu-1.7 {endOfCluster: NUL} -body {
    ::tk::endOfCluster "a\0b" 1
} -result 2

# --- words: original ICU space-skipping semantics ---
test icu-2.1 {startOfNextWord skips the space segment} -body {
    ::tk::startOfNextWord "hello world" 0
} -result 6
test icu-2.2 {startOfNextWord from the space} -body {
    ::tk::startOfNextWord "hello world" 5
} -result 6
test icu-2.3 {startOfPreviousWord from inside a word} -body {
    ::tk::startOfPreviousWord "hello world" 7
} -result 6
test icu-2.4 {startOfPreviousWord from a word start} -body {
    ::tk::startOfPreviousWord "hello world" 6
} -result 0
test icu-2.5 {endOfWord returns the end of the word} -body {
    ::tk::endOfWord "hello world" 0
} -result 5
# Original ICU behaviour: endOfWord whose following break is the
# end of the string returns NO result (the original set idx to
# TCL_INDEX_NONE when following() landed on len). Not 11.
test icu-2.6 {endOfWord from inside second word, at end} -body {
    ::tk::endOfWord "hello world" 7
} -result {}
test icu-2.7 {word commands work on astral text, char indices} -body {
    ::tk::startOfNextWord "\U0001F600 hello" 0
} -result 2

# --- availability: these must exist with no libicu installed ---
test icu-3.1 {all five commands exist} -body {
    expr {[info commands ::tk::startOfCluster] ne ""
        && [info commands ::tk::endOfCluster] ne ""
        && [info commands ::tk::startOfNextWord] ne ""
        && [info commands ::tk::startOfPreviousWord] ne ""
        && [info commands ::tk::endOfWord] ne ""}
} -result 1

# --- TCL8 compat delegation still works ---
test icu-4.1 {TCL8 locale delegates} -body {
    ::tk::startOfNextWord "hello world" 0 TCL8
} -result 6

cleanupTests
