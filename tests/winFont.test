} -result {1 1}

test winfont-5.11 {Tk_MeasureChars procedure: check for kerning} -constraints {
    win nonPortable
} -setup {
    destroy .t.l
}  -body {
    label .t.l -padx 0 -pady 0 -bd 0 -highlightthickness 0 -justify left \
	-text "0" -font systemfixed
    pack .t.l
    update

    set font [.t.l cget -font]
    .t.l config -font {{MS Sans Serif} 8} -text "W"
    set width [winfo reqwidth .t.l]
    .t.l config -text "XaYoYaKaWx"
    set x [lindex [getsize .t.l] 0]
    .t.l config -font $font
    expr {$x < ($width*10)}
} -cleanup {
    destroy .t.l
} -result 1


test winfont-6.1 {Tk_DrawChars procedure: loop test} -constraints win -setup {
    destroy .t.l
}  -body {
    label .t.l -padx 0 -pady 0 -bd 0 -highlightthickness 0 -justify left \
	-text "0" -font systemfixed
    pack .t.l
    update
    .t.l config -text "a"
    update
} -cleanup {
    destroy .t.l
} -result {}


test winfont-7.1 {InitFont procedure: use old font} -constraints win -setup {
    destroy .c
} -setup {
    catch {font delete xyz}
} -body {
    font create xyz
    button .c -font xyz
    font configure xyz -family times
    update
    destroy .c
    font delete xyz
} -result {}
test winfont-7.2 {InitFont procedure: extract info from logfont} -constraints {
    win
} -body {
    font actual {arial 10 bold italic underline overstrike}
} -result {-family Arial -size 10 -weight bold -slant italic -underline 1 -overstrike 1}
test winfont-7.3 {InitFont procedure: extract info from textmetric} -constraints {
    win
} -body {
    font metric {arial 10 bold italic underline overstrike} -fixed
} -result 0
test winfont-7.4 {InitFont procedure: extract info from textmetric} -constraints {
    win
} -body {
    font metric systemfixed -fixed
} -result 1

#
# TESTFILE CLEANUP
#

testutils forget geometry
#
# Subfont selection for emoji (UTS #51): a color emoji font for the default emoji
# presentation and for VS16 sequences, text presentation left to the usual fallbacks,
# an explicit base font respected, and a ZWJ sequence shaped as one glyph.
#
testConstraint segoeEmoji [expr {"Segoe UI Emoji" in [font families]}]
testConstraint segoeSymbol [expr {"Segoe UI Symbol" in [font families]}]

test winfont-8.1 {FindSubFontForChar: default emoji presentation gets the color font} -constraints {
    win segoeEmoji
} -body {
    font actual TkDefaultFont -family -- [format %c 0x1F600]
} -result {Segoe UI Emoji}
test winfont-8.2 {FindSubFontForChar: text presentation is not sent to the color font} -constraints {
    win segoeEmoji segoeSymbol
} -body {
    expr {[font actual TkDefaultFont -family -- [format %c 0x2764]] eq "Segoe UI Emoji"}
} -result 0
test winfont-8.3 {FindSubFontForChar: an explicit base font keeps its own glyphs} -constraints {
    win segoeSymbol
} -body {
    font actual {{Segoe UI Symbol} 14} -family -- [format %c 0x1F600]
} -result {Segoe UI Symbol}
test winfont-8.4 {TkWinShapeString: ZWJ sequence shaped as one glyph} -constraints {
    win segoeEmoji
} -body {
    set f {{Segoe UI} 14}
    set zwj "[format %c 0x1F469][format %c 0x200D][format %c 0x1F4BB]"
    expr {[font measure $f $zwj] == [font measure $f [format %c 0x1F469]]}
} -result 1
test winfont-8.5 {TkWinShapeString: VS16 selects the emoji glyph} -constraints {
    win segoeEmoji
} -body {
    set f {{Segoe UI} 14}
    expr {[font measure $f "[format %c 0x2764][format %c 0xFE0F]"]
	    > [font measure $f [format %c 0x2764]]}
} -result 1
test winfont-8.6 {TkWinShapeString: skin tone modifier joins its base} -constraints {
    win segoeEmoji
} -body {
    set f {{Segoe UI} 14}
    expr {[font measure $f "[format %c 0x1F44D][format %c 0x1F3FD]"]
	    == [font measure $f [format %c 0x1F44D]]}
} -result 1
test winfont-8.7 {TkWinShapeString: text around an emoji stays in the base font} -constraints {
    win segoeEmoji
} -body {
    set f {{Segoe UI} 14}
    set e [format %c 0x1F600]
    expr {[font measure $f "a${e}b"]
	    == [font measure $f a] + [font measure $f $e] + [font measure $f b]}
} -result 1
test winfont-8.8 {TkWinShapeString: VS15 stays with its base character} -constraints {
    win segoeSymbol
} -body {
    set f {{Segoe UI} 14}
    expr {[font measure $f "[format %c 0x2764][format %c 0xFE0E]"]
	    == [font measure $f [format %c 0x2764]]}
} -result 1

#
# Color emoji: the color layers of a COLR font are drawn (DirectWrite/Direct2D), text
# presentation and glyphs without layers stay in the text color (GDI).  The pixels are
# read back with testwinpixel on a grid inside the glyph: a saturated pixel (chroma
# above 100) can only come from a color layer, never from a black glyph on white.
#
testConstraint testwinpixel [llength [info commands testwinpixel]]
testConstraint testwingdiobjects [llength [info commands testwingdiobjects]]

# The pixels are read from the screen: keep the test window above everything.
wm attributes . -topmost 1
raise .

proc winfontColoredSamples {w} {
    set n 0
    set width [winfo width $w]
    set height [winfo height $w]
    foreach fx {0.35 0.5 0.65} {
	foreach fy {0.3 0.45 0.6} {
	    set c [testwinpixel $w [expr {int($width * $fx)}] [expr {int($height * $fy)}]]
	    scan $c "#%2x%2x%2x" r g b
	    if {max($r, $g, $b) - min($r, $g, $b) > 100} {
		incr n
	    }
	}
    }
    return $n
}

test winfont-9.1 {TkWinDrawColorGlyphs: color layers of an emoji are drawn} -constraints {
    win segoeEmoji testwinpixel
} -setup {
    destroy .l
} -body {
    label .l -text [format %c 0x1F600] -font {{Segoe UI} 72} -foreground black \
	-background white -padx 0 -pady 0 -borderwidth 0 -highlightthickness 0
    pack .l
    update
    expr {[winfontColoredSamples .l] >= 3}
} -cleanup {
    destroy .l
} -result 1
test winfont-9.2 {TkWinDrawColorGlyphs: text presentation stays in the text color} -constraints {
    win segoeSymbol testwinpixel
} -setup {
    destroy .l
} -body {
    label .l -text [format %c 0x2764] -font {{Segoe UI} 72} -foreground black \
	-background white -padx 0 -pady 0 -borderwidth 0 -highlightthickness 0
    pack .l
    update
    expr {[winfontColoredSamples .l] <= 1}
} -cleanup {
    destroy .l
} -result 1
test winfont-9.3 {TkWinDrawColorGlyphs: a run without color layers is left to GDI} -constraints {
    win segoeEmoji testwinpixel
} -setup {
    destroy .l
} -body {
    label .l -text a -font {{Segoe UI Emoji} 72} -foreground black \
	-background white -padx 0 -pady 0 -borderwidth 0 -highlightthickness 0
    pack .l
    update
    expr {[winfontColoredSamples .l] <= 1}
} -cleanup {
    destroy .l
} -result 1

# Scan the label on a grid of 3 pixels for a pixel of the given dominant color.
proc winfontHasPixel {w test} {
    set width [winfo width $w]
    set height [winfo height $w]
    for {set x 1} {$x < $width} {incr x 3} {
	for {set y 1} {$y < $height} {incr y 3} {
	    scan [testwinpixel $w $x $y] "#%2x%2x%2x" r g b
	    if {[expr $test]} {
		return 1
	    }
	}
    }
    return 0
}

test winfont-9.4 {glyph cache: the same emoji drawn twice (second draw from the cache)} -constraints {
    win segoeEmoji testwinpixel
} -setup {
    destroy .l1 .l2
} -body {
    foreach w {.l1 .l2} {
	label $w -text [format %c 0x1F600] -font {{Segoe UI} 72} -foreground black \
	    -background white -padx 0 -pady 0 -borderwidth 0 -highlightthickness 0
	pack $w -side left
    }
    update
    expr {[winfontColoredSamples .l1] >= 3 && [winfontColoredSamples .l2] >= 3}
} -cleanup {
    destroy .l1 .l2
} -result 1
test winfont-9.5 {glyph cache: a glyph in the text color follows a color change} -constraints {
    win segoeEmoji testwinpixel
} -setup {
    destroy .l
} -body {
    # "a" has no color layers but shares the run of the emoji: drawn from the cache
    # in the text color, and rendered again when that color changes.
    label .l -text "a[format %c 0x1F600]" -font {{Segoe UI Emoji} 72} -foreground black \
	-background white -padx 0 -pady 0 -borderwidth 0 -highlightthickness 0
    pack .l
    update
    set before [winfontHasPixel .l {$r > 200 && $g < 60 && $b < 60}]
    .l configure -foreground red
    update
    list $before [winfontHasPixel .l {$r > 200 && $g < 60 && $b < 60}]
} -cleanup {
    destroy .l
} -result {0 1}
test winfont-9.6 {glyph cache: a new size and a new scaling render fresh glyphs} -constraints {
    win segoeEmoji testwinpixel
} -setup {
    destroy .l .m
    set scaling [tk scaling]
} -body {
    label .l -text [format %c 0x1F600] -font {{Segoe UI} 36} -foreground black \
	-background white -padx 0 -pady 0 -borderwidth 0 -highlightthickness 0
    pack .l -side left
    update
    set small [winfo width .l]
    .l configure -font {{Segoe UI} 72}
    update
    set large [winfo width .l]
    tk scaling [expr {$scaling * 2}]
    label .m -text [format %c 0x1F600] -font {{Segoe UI} 36} -foreground black \
	-background white -padx 0 -pady 0 -borderwidth 0 -highlightthickness 0
    pack .m -side left
    update
    list [expr {$large > $small * 1.5}] [expr {[winfo width .m] > $small * 1.5}] \
	[expr {[winfontColoredSamples .l] >= 3}] [expr {[winfontColoredSamples .m] >= 3}]
} -cleanup {
    tk scaling $scaling
    destroy .l .m
} -result {1 1 1 1}
test winfont-9.7 {glyph cache: bounded pages, no GDI object leak} -constraints {
    win segoeEmoji testwingdiobjects
} -setup {
    destroy .t
    set emoji {}
    for {set cp 0x1F300} {$cp < 0x1F550} {incr cp} {
	append emoji [format %c $cp]
    }
} -body {
    text .t -width 40 -height 10 -wrap char
    pack .t
    update
    set before [testwingdiobjects]
    .t tag configure small -font {{Segoe UI} 12}
    .t tag configure large -font {{Segoe UI} 24}
    .t insert end $emoji\n small $emoji\n large
    for {set i 0} {$i < 40} {incr i} {
	.t yview moveto [expr {$i / 40.0}]
	update
    }
    set during [testwingdiobjects]
    destroy .t
    update
    set after [testwingdiobjects]
    # per size: the base font, the emoji and symbol subfonts, one DC and at most
    # 4 pages; plus the Direct2D context
    list [expr {$during - $before <= 2 * 8 + 6}] [expr {$after - $before <= 2}]
} -cleanup {
    destroy .t
} -result {1 1}

wm attributes . -topmost 0

cleanupTests

# Local variables:
# mode: tcl
# End:
